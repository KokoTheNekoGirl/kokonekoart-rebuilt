---
import { SITE_TITLE, SITE_DESCRIPTION } from '@consts';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { SkipLink, ReducedMotion } from 'accessible-astro-components'
import { BaseHead, HeaderLink, Stars } from '@components';
import { Logo, KokoNekoArt } from '@assets';

interface Props {
    title?: string;
    description?: string;
    image?: ImageMetadata;
    imageAlt?: string;
    noindex?: boolean;
    type?: 'website' | 'article';
}

const {
    title = SITE_TITLE,
    description = SITE_DESCRIPTION,
    image,
    imageAlt,
    noindex = false,
    type = 'website'
} = Astro.props;

const segments = Astro.url.pathname.split('/').filter(Boolean);
const slug = segments.at(-1) ?? 'home';

const isCategory = segments[0] === 'portfolio' && segments[1] === 'project' && segments.length > 2;
const isPortfolioPiece = segments[0] === 'portfolio' && segments.length > 1 && !isCategory;

const bodyClasses = isCategory
  ? ['page-portfolio', `category-${slug}`]
  : isPortfolioPiece
    ? ['portfolio-piece', `portfolio-${slug}`]
    : [`page-${slug}`];

const today = new Date();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
        noindex={noindex}
        type={type}
    />
    <slot name="head" />
</head>

<body class:list={bodyClasses}>
    <SkipLink />

    <Stars />

    <section class="topbar">
        <span>I stand with human artists and developers. <a href="https://www.teamhuman.org/" target="_blank" rel="external" aria-describedby="external-hint">Support #TeamHuman</a>.</span>
    </section>
    <header id="header">
        <a class="site-branding" href="/" title={SITE_TITLE} rel="home" itemprop="url">
            <Image class="site-logo" src={Logo} alt={`${SITE_TITLE}'s Logo`} width={400} height={400} loading="eager" fetchpriority="high" />
            <Image class="site-name" src={KokoNekoArt} alt={SITE_TITLE} width={1011} height={140} loading="eager" fetchpriority="high" />
        </a>
        <nav id="site-nav" class="site-nav" aria-label="Main" itemscope itemtype="https://schema.org/SiteNavigationElement">
            <button id="menu-toggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-list" aria-label="Open main menu">
                <i id="menu-icon" class="fa-solid" aria-hidden="true"></i>
            </button>
            <div class="menu-main-menu-container">
                <ul class="menu" id="menu-list">
                    <li class="menu-item"><HeaderLink href="/about-me">About</HeaderLink></li>
                    <li class="menu-item"><HeaderLink href="/commission-me">Commissions</HeaderLink></li>
                    <li class="menu-item"><HeaderLink href="/portfolio">Portfolio</HeaderLink></li>
                    <li class="menu-item"><HeaderLink href="/contact">Contact</HeaderLink></li>
                </ul>
            </div>
        </nav>
    </header>

    <main id="main-content"><article class="container" itemprop="mainContentOfPage">
        <slot />
    </article></main>

    <footer id="footer" role="contentinfo">
        <div id="copyright">
            {SITE_TITLE} &copy; {today.getFullYear()} | All rights reserved. |
            <div class="motion-control">
            <ReducedMotion initialMode="auto" label="Toggle reduced motion">
                <i slot="off" class="fa-solid fa-circle-play" aria-hidden="true"></i>
                <i slot="on" class="fa-solid fa-circle-pause" aria-hidden="true"></i>
            </ReducedMotion>
            </div>
        </div>
    </footer>

    <noscript>
        <style>.animate__animated { animation: none !important; }</style>
    </noscript>

    <script>
        const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle')!;
        const nav = document.querySelector<HTMLElement>('#site-nav')!;
        const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
        const setOpen = (open: boolean) => {
            toggle.setAttribute('aria-expanded', String(open));
            toggle.setAttribute('aria-label', open ? 'Close main menu' : 'Open main menu');
        };
        toggle.addEventListener('click', () => setOpen(!isOpen()));
        nav.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && isOpen()) { setOpen(false); toggle.focus(); }
            });
        matchMedia('(min-width: 1001px)').addEventListener('change', (e) => e.matches && setOpen(false));

        const els = document.querySelectorAll<HTMLElement>('.animate__animated');
        const reduce = document.documentElement.classList.contains('reduce-motion');

        if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in-view'));
        } else {
        const io = new IntersectionObserver(
            (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); }
            }),
            { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
        }
    </script>

    <span id="external-hint" class="sr-only">(opens in a new window)</span>

</body>
</html>

