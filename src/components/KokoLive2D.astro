---
import { Image } from 'astro:assets';
import { KokoReduced } from '@assets';
---

<!--
  Koko on the home page. The still image shows first (and stays for reduced motion, slow
  connections and browsers without WebGL); the Live2D model fades in over it once it has loaded.
-->
<div class="hero-img koko-live2d animate__animated animate__fadeIn" data-koko-live2d>
  <Image
    class="koko-still"
    src={KokoReduced}
    alt="My fursona Koko, a silver tabby with big blue eyes."
    loading="eager"
    fetchpriority="high"
  />
  <canvas class="koko-canvas" aria-hidden="true"></canvas>
</div>

<script>
  import { initKokoLive2D } from '@utils/live2d-hero';

  document.querySelectorAll<HTMLElement>('[data-koko-live2d]').forEach(initKokoLive2D);
</script>

<style>
  .koko-live2d {
    /* size and position come from .hero-img in _sections.scss */
    aspect-ratio: 1 / 1;
  }
  .koko-still,
  .koko-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .koko-still {
    object-fit: contain;
  }
  .koko-canvas {
    opacity: 0;
    transition: opacity 0.4s;
    touch-action: manipulation;
  }
  .koko-live2d.is-live .koko-canvas {
    opacity: 1;
  }
  .koko-live2d.is-live .koko-still {
    opacity: 0;
    transition: opacity 0s 0.4s;
  }

  @media only screen and (max-width: 750px) {
    .koko-live2d {
      position: relative;
      right: auto;
      width: 100%;
      max-width: 500px;
      height: auto;
      margin: 0 auto;
    }
  }
</style>
